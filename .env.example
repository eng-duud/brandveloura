# ==============================================================================
# Brand Veloura Boutique — دليل ومتغيرات البيئة للإنتاج و Railway (.env.example)
# ==============================================================================
# يمكنك نسخ هذا الملف إلى .env محلياً، أو إضافتها في لوحة تحكم Railway (Variables)

# ------------------------------------------------------------------------------
# 1. إعدادات Django و Railway الأساسية (Essential Core Settings)
# ------------------------------------------------------------------------------
DJANGO_SECRET_KEY=generate-a-strong-secret-key-for-production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=*
# مسار لوحة الإدارة السري (لتغيير /admin/ إلى مسار خاص بك لا يعرفه المتطفلون):
# DJANGO_ADMIN_URL=veloura-manage-panel
# في بيئة الإنتاج على Railway، ضع نطاق متجرك ونطاق Railway المخصص:
# CSRF_TRUSTED_ORIGINS=https://*.railway.app,https://*.up.railway.app,https://yourcustomdomain.com

# ------------------------------------------------------------------------------
# 2. قاعدة البيانات السحابية (Railway PostgreSQL)
# ------------------------------------------------------------------------------
# عند إضافة إضافة PostgreSQL في Railway، سيتم حقن هذا المتغير تلقائياً
# DATABASE_URL=postgresql://postgres:password@roundhouse.proxy.rlwy.net:12345/railway

# ------------------------------------------------------------------------------
# 3. التخزين السحابي للصور والوسائط (Cloudinary Integration)
# ------------------------------------------------------------------------------
# يتيح تخزين صور المنتجات، البانرات، وشعارات المتجر وإيصالات التحويل البنكي سحابياً:
# الطريقة الأولى (الرابط الموحد - مدعوم تلقائياً):
# CLOUDINARY_URL=cloudinary://<API_KEY>:<API_SECRET>@<CLOUD_NAME>

# الطريقة الثانية (المفاتيح المنفصلة من dashboard.cloudinary.com):
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret


# ------------------------------------------------------------------------------
# 4. تسجيل الدخول عبر Google OAuth 2.0 (Google Identity Services)
# ------------------------------------------------------------------------------
# للحصول على هذه البيانات من Google Cloud Console (console.cloud.google.com):
# 1. أنشئ مشروع جديد أو اختر مشروعك الحالي
# 2. توجه إلى APIs & Services -> Credentials -> Create Credentials -> OAuth client ID
# 3. Application type: Web application
# 4. Authorized JavaScript origins:
#    - https://your-project.up.railway.app (نطاق Railway الخاص بك)
#    - http://localhost:8000 (للتجربة المحلية)
# 5. Authorized redirect URIs:
#    - https://your-project.up.railway.app/auth/google/callback/
#    - http://localhost:8000/auth/google/callback/
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ------------------------------------------------------------------------------
# 5. بيانات التواصل وهوية المتجر (Store Contacts & Identity)
# ------------------------------------------------------------------------------
STORE_WHATSAPP=967770000000
STORE_PHONE=+967 770 000 000
STORE_INSTAGRAM=brandveloura

# ------------------------------------------------------------------------------
# 6. إثبات ملكية محرك بحث جوجل (Google Search Console Verification)
# ------------------------------------------------------------------------------
# كود إثبات الملكية لـ Google Search Console (في حال اخترت وسم HTML Tag بدلاً من سجل DNS):
# GOOGLE_SITE_VERIFICATION=your-google-verification-code
